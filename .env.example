# etch environment configuration
#
# Copy this file to .env and fill in the keys for the providers you use.
# The model is chosen per request via the "model" param: start_diagram_job
# defaults to gemini-3-pro-image-preview, start_variant_job to
# gemini-3.1-flash-image. Each provider resolves its own key, so you only
# need credentials for the providers you actually call.

# Google Gemini — the default provider (model: gemini-3-pro-image-preview).
# Get a key from https://aistudio.google.com/
# This one key covers everything Gemini — Nano Banana 2 (model:
# gemini-3.1-flash-image, start_variant_job's default) and reference-image
# conditioning ("reference_images", Gemini only, up to 14 images) — no
# separate env var needed.
GOOGLE_API_KEY=

# Microsoft MAI-Image-2.5 — optional, required only when using
# model="mai-image-2.5". MAI tops out at ~1 MP, so it supports 1K only
# (no 2K) and excludes the 21:9 aspect ratio. Reach it via one of two
# transports, set by MAI_TRANSPORT (default "foundry").
MAI_TRANSPORT=foundry

# Transport A — Azure AI Foundry (MAI_TRANSPORT=foundry):
MAI_API_KEY=
MAI_ENDPOINT=          # Azure resource base, e.g. https://<resource>.services.ai.azure.com
MAI_DEPLOYMENT=MAI-Image-2.5

# Transport B — OpenRouter (MAI_TRANSPORT=openrouter; no Azure provisioning):
OPENROUTER_API_KEY=    # sk-or-...
# MAI_OPENROUTER_MODEL=microsoft/mai-image-2.5   # override the model slug if needed
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions   # override the endpoint (e.g. a proxy)
