# etch environment configuration
#
# Copy this file to .env and fill in the keys for the providers you use.
# The model is chosen per request via the start_diagram_job "model" param,
# which defaults to gemini-3-pro-image-preview. Each provider resolves its
# own key, so you only need credentials for the providers you actually call.

# Google Gemini — the default provider (model: gemini-3-pro-image-preview).
# Get a key from https://aistudio.google.com/
GOOGLE_API_KEY=

# Microsoft MAI-Image-2.5 — optional, required only when using
# model="mai-image-2.5". MAI tops out at ~1 MP, so it supports 1K only
# (no 2K) and excludes the 21:9 aspect ratio.
MAI_API_KEY=
MAI_ENDPOINT=          # Azure resource base, e.g. https://<resource>.services.ai.azure.com
MAI_DEPLOYMENT=MAI-Image-2.5
